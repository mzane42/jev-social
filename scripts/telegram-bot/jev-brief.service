[Unit]
Description=jev-social morning brief (radar + brief + Telegram), pushed to the private veille branch
After=network-online.target xvfb@:99.service
Wants=network-online.target xvfb@:99.service
# --social goes through shop-guard: TikTok searches are skipped while a socai run is active or < 10 min old.

[Service]
Type=oneshot
User=anis
WorkingDirectory=/home/anis/www/jev-social
EnvironmentFile=/etc/notify/channels/jev.env
Environment=HOME=/home/anis
Environment=DISPLAY=:99
Environment=JEV_BRIEF_DIR=/var/lib/jev/veille/drama/foot-manga-drama/veille
Environment=PATH=/home/anis/.local/bin:/home/anis/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/anis/www/jev-social/scripts/telegram-bot/brief-daily.sh football-anime
TimeoutStartSec=30min
NoNewPrivileges=true
